        {
          "title": "Assessment Rationale",
          "level": 2,
          "path": [
            "Red List Assessment",
            "Assessment Rationale"
          ],
          "blocks": [
            {
              "type": "paragraph",
              "text": "Basselinia pancheri is an endemic, solitary, rarely clustered, subcanopy to emergent tree palm largely distributed throughout Grande Terre in New Caledonia. Basselinia pancheri occurs in dense humid forest and secondary forests on serpentine soils derived from ultramafic rocks from sea level to 1,000 m asl. This species not seem directly threatened hence B. pancheri is considered Least Concern (LC)."
            },
            {
              "type": "style",
              "data": {
                "bold": [],
                "italic": [
                  "Basselinia pancheri",
                  "B. pancheri"
                ]
              }
            }
          ],
          "children": []
        }
      ]
    },
